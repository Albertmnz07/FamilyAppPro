# Compose variables for compose.dev.yml (TN-28) and compose.prod.yml (TN-29).
# These are the only variables the compose files read; each default below
# matches the default in the compose files. Copy to `.env` (git-ignored) to
# override; an absent `.env` starts both stacks with these local-only values.

# PostgreSQL credentials, shared by the database container and the API. The
# official image creates this role and database on first start.
POSTGRES_USER=familyapp
POSTGRES_PASSWORD=familyapp
POSTGRES_DB=familyapp

# Development only: the API base URL baked into the app by compose.dev.yml.
# Production hardcodes the same-origin relative `/api/v1` as a build arg in
# compose.prod.yml, so this value is not used there. Both stacks publish 8070.
VITE_API_BASE_URL=http://localhost:8070/api/v1
