# Compose variables for compose.dev.yml (TN-28) and compose.prod.yml (TN-29).
#
# Copy this file to `.env` (git-ignored) to override any value. Every variable
# below already defaults to the same value in the compose files, so an empty or
# absent `.env` is enough to start the stack.

# PostgreSQL credentials, shared by the database container and the API. The
# official image creates this role and database on first start.
POSTGRES_USER=familyapp
POSTGRES_PASSWORD=familyapp
POSTGRES_DB=familyapp

# Development only: the API base URL the Vite dev server bakes into the app
# (compose.dev.yml). Production hardcodes the same-origin relative `/api/v1` at
# image build time instead, and publishes the app on the host as `8070:8070`.
VITE_API_BASE_URL=http://localhost:8070/api/v1
