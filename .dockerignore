# Build context for the back-end image. The Spring Boot project lives at the
# repository root, so this is the root .dockerignore rather than backend/.dockerignore.
# Keep the sources and the Maven wrapper; drop host build output, dependencies
# and local data.
apps/backend/target/
apps/frontend/node_modules/
apps/frontend/dist/
data/
.git/
.idea/
.kdev4/
FamilyApp.kdev4
*.iml
.vscode/
.env
.env.*
.DS_Store

# Documentation and tooling not needed to build the jar. Excluding them keeps
# the build context small and avoids invalidating the source layer when only
# docs or local tooling change.
docs/
db/
Makefile
README.md
AGENTS.md
CODING_STANDARDS.md
GLOSSARY.md
.agents/
.githooks/
skills-lock.json
compose.dev.yml
compose.prod.yml
